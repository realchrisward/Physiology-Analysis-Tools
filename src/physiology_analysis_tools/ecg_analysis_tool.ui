           <property name="text">
            <string>Beat: - / -</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="audit_top_spacer">
           <property name="orientation">
            <enum>Qt::Orientation::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
         <item>
          <widget class="QPushButton" name="pushButton_save_audit">
           <property name="text">
            <string>Save Audit</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <!-- Audit controls row 2: label buttons + notes -->
       <item>
        <layout class="QHBoxLayout" name="audit_label_row">
         <item>
          <widget class="QLabel" name="label_audit_label">
           <property name="text">
            <string>Audit Label:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pushButton_audit_bad_signal">
           <property name="text">
            <string>Bad Signal</string>
           </property>
           <property name="toolTip">
            <string>Mark this beat window as containing bad/uninterpretable signal</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pushButton_audit_bad_beat_calls">
           <property name="text">
            <string>Good Signal / Bad Beat Calls</string>
           </property>
           <property name="toolTip">
            <string>Signal is good but beat detection is incorrect in this window</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pushButton_audit_no_arrhythmia">
           <property name="text">
            <string>Good Beats / No Arrhythmia</string>
           </property>
           <property name="toolTip">
            <string>Beat calls are correct but no arrhythmia is present</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pushButton_audit_arrhythmia_confirmed">
           <property name="text">
            <string>Good Beats / Arrhythmia Confirmed</string>
           </property>
           <property name="toolTip">
            <string>Beat calls are correct and arrhythmia is confirmed</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="label_audit_notes">
           <property name="text">
            <string>Notes:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="lineEdit_audit_notes">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="placeholderText">
            <string>Optional audit note for this beat...</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>

       <!-- Audit status row -->
       <item>
        <layout class="QHBoxLayout" name="audit_status_row">
         <item>
          <widget class="QLabel" name="label_audit_current">
           <property name="text">
            <string>Current audit label: None</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="audit_status_spacer">
           <property name="orientation">
            <enum>Qt::Orientation::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
         <item>
          <widget class="QLabel" name="label_audit_file_status">
           <property name="text">
            <string>Audit file: not loaded</string>
           </property>
           <property name="alignment">
            <set>Qt::AlignmentFlag::AlignRight|Qt::AlignmentFlag::AlignVCenter</set>
           </property>
          </widget>
         </item>
        </layout>
       </item>

      </layout>
     </widget>
    </item>

   </layout>
  </widget>

